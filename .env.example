PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/workforce_erp

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Attendance rules (all optional - sensible defaults are baked in)
STANDARD_CHECKIN_TIME=09:30
LATE_GRACE_MINUTES=10
STANDARD_WORK_HOURS=9
HALF_DAY_THRESHOLD_HOURS=4
ATTENDANCE_TARGET_PERCENTAGE=75
WEEKEND_DAYS=0,6

# Annual leave allocations, in days (all optional - sensible defaults are baked in)
LEAVE_ALLOCATION_CASUAL=12
LEAVE_ALLOCATION_SICK=10
LEAVE_ALLOCATION_EARNED=15
LEAVE_ALLOCATION_WFH=60
LEAVE_ALLOCATION_EMERGENCY=5

# Task workload labeling thresholds (count of non-COMPLETED tasks)
WORKLOAD_LOW_MAX=3
WORKLOAD_HIGH_MIN=8
